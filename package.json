{
  "name": "ceptory-mcp",
  "version": "1.0.0",
  "description": "Ceptory MCP server: manage cameras, workflows, alerts and video search from Claude, Cursor, Codex, Gemini or any MCP agent.",
  "type": "module",
  "bin": {
    "ceptory-mcp": "build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "start:http": "node build/index.js --http",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ceptory",
    "cctv",
    "camera",
    "video-search",
    "ai-agent",
    "claude",
    "cursor",
    "codex",
    "gemini"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whyashthakker/ceptory-mcp.git"
  },
  "homepage": "https://www.ceptory.com",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
